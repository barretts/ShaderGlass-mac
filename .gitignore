# Vendored upstream dependency checkouts (fetched / rebuildable; each has its own .git)
deps/glslang/
deps/SPIRV-Cross/

# Compiled probes, test binaries, and the demo binary
deps/check_msl
deps/*.o
spike/spike
backend/backend_test
capture/capture_test
demo/demo

# The built .app bundle + selftest output (regenerate via app/build.sh)
app/build/

# The core static library and test outputs (regenerate via core/build_core.sh)
core/build/

# Generated render outputs (regenerate via demo/build.sh)
demo/out/

# Logs, object files, compiled shader libs
**/.logs/
**/*.o
*.metallib

# Local commit-message scratch file
.gitmsg

# macOS Finder cruft
.DS_Store
**/.DS_Store

# Signing key material -- defense against an accidental cert/key export landing in the tree
*.p12
*.pem
*.cer
*.keychain
*.keychain-db
