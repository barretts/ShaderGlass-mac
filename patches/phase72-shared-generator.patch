+std::pair<std::string, std::string> SPIRV::GenerateMSL(const std::vector<uint32_t>& bin, bool fragment, std::ostream& log, bool& warn)
+{
+    (void)log;
+    (void)warn;
+
+#if !defined(__APPLE__)
+    (void)bin;
+    (void)fragment;
+    throw std::runtime_error("MSL generation is only wired for macOS builds");
+#else
+    try
+    {
+        CompilerMSL msl(bin);
+
+        CompilerMSL::Options options;
+        options.platform = CompilerMSL::Options::macOS;
+        options.set_msl_version(2, 1, 0);
+        options.enable_decoration_binding = true;
+        msl.set_msl_options(options);
+        std::string source = msl.compile();
+
+        std::string metadata;
+        if(fragment)
+        {
+            CompilerReflection refl(bin);
+            metadata = refl.compile();
+        }
+
+        return std::make_pair(source, metadata);
+    }
+    catch(std::exception& ex)
+    {
+        std::ostringstream msg;
+        msg << "MSL Generation Error" << std::endl;
+        msg << ex.what();
+        throw std::runtime_error(msg.str());
+    }
+#endif
+}
